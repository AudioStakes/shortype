{
  "name": "my-shortcut-keys",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome lint . && vue-tsc --noEmit",
    "check": "biome check . && vue-tsc --noEmit",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.3.1",
    "@vue/test-utils": "^2.4.10",
    "@vitejs/plugin-vue": "^6.0.7",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.1"
  }
}
