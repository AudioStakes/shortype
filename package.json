{
  "name": "my-shortcut-keys",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-preact-preset-vite.mjs",
    "test": "vitest run",
    "lint": "biome lint . && tsc --noEmit",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.3.1",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "zimmerframe": "file:vendor/zimmerframe"
  }
}
