{
  "name": "my-shortcut-keys",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:shuffle:1": "vitest run --sequence.shuffle --sequence.seed=1",
    "test:shuffle:42": "vitest run --sequence.shuffle --sequence.seed=42",
    "test:mutation": "stryker run",
    "lint": "biome check . --error-on-warnings && eslint . --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm run knip",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && tsc -p tsconfig.e2e.json",
    "knip": "knip --treat-config-hints-as-errors",
    "check:workflow": "actionlint -shellcheck= -pyflakes=",
    "audit": "npm audit --include=dev --audit-level=low",
    "validate": "npm run check && npm run check:workflow && npm run test:coverage && npm run test:shuffle:1 && npm run test:shuffle:42 && npm run build && npm run test:e2e && npm run test:mutation && npm run audit",
    "test:e2e": "playwright test",
    "postinstall": "git apply --reverse --check patches/unconfig+7.5.0.patch 2>/dev/null || git apply patches/unconfig+7.5.0.patch",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format . --error-on-warnings"
  },
  "overrides": {
    "unconfig": "7.5.0"
  },
  "dependencies": {
    "preact": "10.29.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.12.4",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "1.6.27",
    "csv-parse": "7.0.3",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "happy-dom": "20.9.0",
    "knip": "6.42.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "unocss": "66.7.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
